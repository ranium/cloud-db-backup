APP_NAME=cloud-db-backup
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=info

# This app has no database of its own.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Backups. See README.md for every option.
# ---------------------------------------------------------------------------

# Unique per Cloud account + region; appears in S3 keys and the run manifest.
BACKUP_DEPLOYMENT=ranium-us-east-2

# Any number of clusters, comma-separated. Each name gets its own block below:
# the name upper-cased, with each run of non-alphanumerics turned into "_".
BACKUP_CLUSTERS=ranium-mysql-1

BACKUP_CLUSTER_RANIUM_MYSQL_1_DRIVER=mysql
BACKUP_CLUSTER_RANIUM_MYSQL_1_HOST=
BACKUP_CLUSTER_RANIUM_MYSQL_1_PORT=3306
BACKUP_CLUSTER_RANIUM_MYSQL_1_USERNAME=
BACKUP_CLUSTER_RANIUM_MYSQL_1_PASSWORD=
# Optional, comma-separated:
# BACKUP_CLUSTER_RANIUM_MYSQL_1_INCLUDE=
# BACKUP_CLUSTER_RANIUM_MYSQL_1_EXCLUDE=

# A PostgreSQL cluster looks like this (Neon needs SSL=require):
# BACKUP_CLUSTER_DEMOS_DRIVER=pgsql
# BACKUP_CLUSTER_DEMOS_HOST=
# BACKUP_CLUSTER_DEMOS_USERNAME=
# BACKUP_CLUSTER_DEMOS_PASSWORD=
# BACKUP_CLUSTER_DEMOS_SSL=require
# BACKUP_CLUSTER_DEMOS_MAINTENANCE_DATABASE=neondb

# Upload-only credentials from the CloudFormation stack (aws/backup-bucket.yml).
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# Any other S3-compatible provider (e.g. DigitalOcean Spaces):
# BACKUP_S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# BACKUP_S3_REGION=blr1
# BACKUP_S3_STORAGE_CLASS=
# BACKUP_S3_USE_PATH_STYLE=false

# age public key(s), comma-separated. Never put a private key here.
BACKUP_AGE_RECIPIENTS=

# Optional healthchecks.io ping URL. Leave empty to disable.
BACKUP_HEALTHCHECK_URL=

# Optional tuning (defaults shown).
# BACKUP_SCHEDULE="30 21 * * *"
# BACKUP_WAKE_TIMEOUT=300
# BACKUP_WAKE_RETRY=10
# BACKUP_DUMP_TIMEOUT=3600
# BACKUP_MONTHLY_DAY=1
