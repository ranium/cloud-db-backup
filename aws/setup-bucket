#!/usr/bin/env bash
#
# Creates or updates the offsite backup bucket described by a stack.json.
#
#   setup-bucket <stack.json> [--plan]
#   setup-bucket <stack.json> --db-key <environment> [--plan]   (digitalocean only)
#
# provider "aws"            Deploys backup-bucket.yml with CloudFormation: the
#                           bucket, its lifecycle rules, the upload-only IAM user
#                           and the GitHub OIDC role. Uses your AWS CLI profile.
#
# provider "digitalocean"   DigitalOcean Spaces, with no console steps. doctl
#                           creates a temporary full-access Spaces key for the
#                           bucket setup (deleted again when the script exits),
#                           the bucket gets the same versioning and retention
#                           rules as "s3-compatible", and then doctl creates the
#                           storage sync's key, limited to this bucket, which gh
#                           stores as github_repository's DESTINATION_* secrets.
#                           --db-key <environment> creates the database apps'
#                           key, stores it as the Laravel Cloud secrets
#                           BACKUP_S3_KEY / BACKUP_S3_SECRET and attaches them to
#                           that environment. No key is ever printed.
#
# provider "s3-compatible"  Any other S3-compatible service (Backblaze B2,
#                           MinIO, ...). Creates the bucket if it is missing,
#                           turns versioning on and applies the same retention
#                           rules through the S3 API. Uses AWS_ACCESS_KEY_ID /
#                           AWS_SECRET_ACCESS_KEY set to that provider's keys.
#                           Access keys are created in the provider's console.
#
# --plan prints what would run and changes nothing.
#
# Needs: bash, jq and the AWS CLI. "digitalocean" also needs doctl, gh (for the
# storage sync's key) and, for --db-key, the Laravel Cloud CLI (cloud). Written
# for bash 3.2, so it runs on macOS.

set -euo pipefail

usage() {
    echo "usage: $0 <stack.json> [--plan]" >&2
    echo "       $0 <stack.json> --db-key <environment> [--plan]   (provider \"digitalocean\")" >&2
    exit 2
}

[ $# -ge 1 ] || usage
config="$1"
shift
plan=false
db_key_environment=""
while [ $# -gt 0 ]; do
    case "$1" in
        --plan) plan=true ;;
        --db-key)
            { [ $# -ge 2 ] && [ -n "$2" ]; } || usage
            db_key_environment="$2"
            shift
            ;;
        *) usage ;;
    esac
    shift
done
[ -f "${config}" ] || { echo "setup-bucket: ${config} not found" >&2; exit 2; }

for tool in jq aws; do
    command -v "${tool}" >/dev/null || { echo "setup-bucket: ${tool} is required" >&2; exit 2; }
done

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Temporary files, and the temporary Spaces key if one was made, are removed
# however the script exits.
work="$(mktemp -d)"
doctl=(doctl)
temp_name=""
temp_key=""
cleanup() {
    # A temporary key may exist without its id having been read back (the
    # script stopped mid-create): find it by its unique name.
    if [ -z "${temp_key}" ] && [ -n "${temp_name}" ]; then
        if ! temp_key="$(spaces_key_access "${temp_name}" 2>/dev/null)"; then
            temp_key=""
            echo "WARNING: could not check whether the temporary full-access Spaces key ${temp_name} exists." >&2
            echo "         Look for it with: ${doctl[*]} spaces keys list" >&2
        fi
    fi
    if [ -n "${temp_key}" ]; then
        if delete_spaces_key "${temp_key}"; then
            echo "Temporary Spaces key deleted."
        else
            echo "WARNING: could not delete the temporary full-access Spaces key ${temp_key}. Delete it now:" >&2
            echo "         ${doctl[*]} spaces keys delete ${temp_key}" >&2
        fi
    fi
    rm -rf "${work}"
}
trap cleanup EXIT

field() {
    # field <jq path> <default>. Only a missing or null value takes the
    # default: jq's `//` would also replace an explicit false.
    jq -r --arg default "$2" "if ($1) == null then \$default else ($1) end | tostring" "${config}"
}

provider="$(field .provider "")"
region="$(field .region "")"
bucket="$(field .bucket "")"
endpoint="$(field .endpoint "")"
daily_days="$(field .retention.daily_days 35)"
monthly_days="$(field .retention.monthly_days 365)"
noncurrent_days="$(field .retention.noncurrent_file_version_days 90)"
dump_recovery_days="$(field .retention.dump_version_recovery_days 7)"

fail() {
    echo "setup-bucket: $*" >&2
    exit 1
}

require() {
    local tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null || fail "${tool} is required for provider \"${provider}\""
    done
}

[ -n "${bucket}" ] || fail "\"bucket\" is required"
[ -n "${region}" ] || fail "\"region\" is required"

for days in "${daily_days}" "${monthly_days}" "${noncurrent_days}" "${dump_recovery_days}"; do
    case "${days}" in
        '' | *[!0-9]* | 0) fail "retention values must be whole numbers of days, at least 1 (got \"${days}\")" ;;
    esac
done

# Standard-IA bills every object for at least 30 days; keeping one for less
# costs the same as keeping it for 30.
if [ "${provider}" = "aws" ] && [ "${daily_days}" -lt 30 ]; then
    echo "setup-bucket: note: daily_days is ${daily_days}; S3 Standard-IA bills at least 30 days per object." >&2
fi

run() {
    if ${plan}; then
        printf '+'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

lifecycle_json() {
    # lifecycle_json full|basic
    jq -n \
        --argjson daily "${daily_days}" \
        --argjson monthly "${monthly_days}" \
        --argjson noncurrent "${noncurrent_days}" \
        --argjson recovery "${dump_recovery_days}" \
        --arg mode "$1" '
        def expire(id; prefix; days): {
            ID: id, Status: "Enabled", Filter: {Prefix: prefix},
            Expiration: {Days: days}
        } + (if $mode == "full" then {NoncurrentVersionExpiration: {NoncurrentDays: $recovery}} else {} end);
        {Rules: (
            [
                expire("db-daily"; "db/daily/"; $daily),
                expire("db-monthly"; "db/monthly/"; $monthly),
                expire("db-manifests"; "db/manifests/"; $monthly),
                {ID: "abort-incomplete-uploads", Status: "Enabled", Filter: {Prefix: ""},
                 AbortIncompleteMultipartUpload: {DaysAfterInitiation: 7}}
            ]
            + (if $mode == "full" then [
                {ID: "files-previous-versions", Status: "Enabled", Filter: {Prefix: "files/"},
                 NoncurrentVersionExpiration: {NoncurrentDays: $noncurrent}},
                {ID: "expired-delete-markers", Status: "Enabled", Filter: {Prefix: ""},
                 Expiration: {ExpiredObjectDeleteMarker: true}}
              ] else [] end)
        )}'
}

setup_aws() {
    local stack github_repository github_branch create_oidc
    stack="$(field .stack_name offsite-backups)"
    github_repository="$(field .github_repository "")"
    github_branch="$(field .github_branch main)"
    create_oidc="$(field .create_github_oidc_provider true)"
    subject_prefix="$(field .github_subject_prefix "")"

    # Repositories can identify themselves to AWS by name
    # (repo:owner/name) or, with GitHub's immutable subject format (the
    # default for new repositories), by permanent ids
    # (repo:owner@123/name@456). The role must trust the form the repository
    # actually sends, so ask GitHub when stack.json does not say.
    if [ -n "${github_repository}" ] && [ -z "${subject_prefix}" ] && command -v gh >/dev/null; then
        if detected="$(gh api "repos/${github_repository}/actions/oidc/customization/sub" 2>/dev/null)"; then
            if [ "$(jq -r '.use_immutable_subject // false' <<<"${detected}")" = "true" ]; then
                subject_prefix="$(jq -r '.sub_claim_prefix // ""' <<<"${detected}")"
            fi
        fi
    fi

    if [ -n "${github_repository}" ]; then
        echo "GitHub OIDC subject the role will trust: ${subject_prefix:-repo:${github_repository}}:ref:refs/heads/${github_branch}"
        if [ -z "${subject_prefix}" ] && ! command -v gh >/dev/null; then
            echo "  (gh is not installed, so the immutable subject format could not be checked; set github_subject_prefix in stack.json if the repository uses it)" >&2
        fi
    fi

    echo "Deploying CloudFormation stack \"${stack}\" in ${region} for bucket ${bucket}."

    run aws cloudformation deploy \
        --region "${region}" \
        --stack-name "${stack}" \
        --template-file "${here}/backup-bucket.yml" \
        --capabilities CAPABILITY_IAM \
        --no-fail-on-empty-changeset \
        --parameter-overrides \
        "BucketName=${bucket}" \
        "DailyRetentionDays=${daily_days}" \
        "MonthlyRetentionDays=${monthly_days}" \
        "NoncurrentFileVersionDays=${noncurrent_days}" \
        "DumpVersionRecoveryDays=${dump_recovery_days}" \
        "GitHubRepository=${github_repository}" \
        "GitHubBranch=${github_branch}" \
        "GitHubSubjectPrefix=${subject_prefix}" \
        "CreateGitHubOidcProvider=${create_oidc}"

    ${plan} && return

    aws cloudformation describe-stacks --region "${region}" --stack-name "${stack}" \
        --query 'Stacks[0].Outputs[].[OutputKey,OutputValue]' --output table

    local user
    user="$(aws cloudformation describe-stacks --region "${region}" --stack-name "${stack}" \
        --query "Stacks[0].Outputs[?OutputKey=='DatabaseUploaderUserName'].OutputValue" --output text)"

    cat <<EOF

Next:
  1. Create the database uploader's access key (once) and put it in each
     cloud-db-backup deployment as BACKUP_S3_KEY / BACKUP_S3_SECRET:
       aws iam create-access-key --user-name ${user}
  2. Set the StorageSyncRoleArn output as the AWS_ROLE_ARN variable in this
     config repository's GitHub settings.
EOF
}

# configure_bucket: creates the bucket if it is missing, turns versioning on
# and applies the retention rules, all through "${s3api[@]}".
configure_bucket() {
    if ${plan}; then
        run "${s3api[@]}" create-bucket --bucket "${bucket}"
    elif "${s3api[@]}" head-bucket --bucket "${bucket}" >/dev/null 2>&1; then
        echo "Bucket exists."
    else
        "${s3api[@]}" create-bucket --bucket "${bucket}" >/dev/null
        echo "Bucket created."
    fi

    if ! run "${s3api[@]}" put-bucket-versioning --bucket "${bucket}" \
        --versioning-configuration Status=Enabled; then
        echo "WARNING: the provider refused versioning. Files deleted or replaced in a source bucket will not be recoverable from the mirror." >&2
    fi

    local rules="${work}/lifecycle.json"

    lifecycle_json full >"${rules}"
    ${plan} && { echo "Lifecycle rules:"; cat "${rules}"; }

    if run "${s3api[@]}" put-bucket-lifecycle-configuration --bucket "${bucket}" \
        --lifecycle-configuration "file://${rules}"; then
        echo "Retention rules applied."
    else
        echo "The provider rejected the full rule set; retrying without the rules for previous versions and delete markers." >&2
        lifecycle_json basic >"${rules}"
        run "${s3api[@]}" put-bucket-lifecycle-configuration --bucket "${bucket}" \
            --lifecycle-configuration "file://${rules}"
        echo "WARNING: the provider did not accept rules for previous versions. On a versioned bucket, expired dumps and" >&2
        echo "         replaced or deleted mirrored files are then kept as previous versions until you delete them, and keep" >&2
        echo "         costing storage. Set a rule for noncurrent versions in the provider's console if it offers one." >&2
    fi
}

setup_s3_compatible() {
    [ -n "${endpoint}" ] || fail "\"endpoint\" is required for provider \"s3-compatible\""

    s3api=(aws --endpoint-url "${endpoint}" --region "${region}" s3api)

    echo "Setting up bucket ${bucket} at ${endpoint}."
    configure_bucket

    cat <<EOF

Next (in the provider's console):
  1. Create an access key limited to this bucket for the cloud-db-backup
     deployments (BACKUP_S3_KEY / BACKUP_S3_SECRET, BACKUP_S3_ENDPOINT=${endpoint}).
  2. Create one for the storage sync and store it as the DESTINATION_ACCESS_KEY_ID
     and DESTINATION_SECRET_ACCESS_KEY secrets in this config repository.
  Unlike AWS, most providers cannot issue a key that writes without being able
  to delete, so treat these keys as able to remove backups.
EOF
}

# ---------------------------------------------------------------------------
# DigitalOcean Spaces
#
# DigitalOcean's API, and so doctl, manages Spaces access keys but not buckets:
# a bucket's versioning and lifecycle rules exist only in the S3 API. So doctl
# makes the keys and the AWS CLI configures the bucket with one of them.
# A Spaces key is either full-access (every bucket in the team) or limited to
# named buckets with "read" or "readwrite"; readwrite can also delete.

# doctl_flag <flag> <command words...>: prints the flag if that doctl command
# has it. doctl 1.x and 2.x differ: 1.x asks before deleting unless given
# --force; 2.x has no --force, never asks, and masks secrets unless given --show.
doctl_flag() {
    local flag="$1" help
    shift
    help="$("${doctl[@]}" "$@" --help 2>/dev/null || true)"
    case "${help}" in
        *"${flag}"*) printf '%s' "${flag}" ;;
    esac
}

# spaces_key_access <name>: the access key id of the Spaces key with that
# name, or nothing. Names are not unique in Spaces; more than one is an error.
spaces_key_access() {
    local keys
    keys="$("${doctl[@]}" spaces keys list -o json)" || fail "doctl could not list Spaces keys"
    jq -r --arg name "$1" '
        if . == null then [] else . end
        | map(select(.name == $name))
        | if length > 1 then error("several keys share the name") else (.[0].access_key // empty) end' <<<"${keys}" \
        || fail "more than one Spaces key is named \"$1\", or doctl's output was unexpected. Check: ${doctl[*]} spaces keys list"
}

# delete_spaces_key <access key>
delete_spaces_key() {
    local force
    force="$(doctl_flag --force spaces keys delete)"
    "${doctl[@]}" spaces keys delete "$1" ${force:+"${force}"} </dev/null >/dev/null 2>&1
}

# create_spaces_key <name> <grants>: creates the key and leaves its id and
# secret in ${work}/key.json, readable only by this user. A secret that comes
# back masked or missing is never stored anywhere: the key is deleted again.
create_spaces_key() {
    local show access secret
    show="$(doctl_flag --show spaces keys create)"
    (umask 077 && "${doctl[@]}" spaces keys create "$1" --grants "$2" ${show:+"${show}"} -o json \
        | jq 'if type == "array" then .[0] else . end | {access_key, secret_key}' >"${work}/key.json") \
        || fail "doctl could not create the Spaces key \"$1\", or returned something unexpected. Check for it with: ${doctl[*]} spaces keys list"
    access="$(jq -r '.access_key // empty' "${work}/key.json")"
    secret="$(jq -r '.secret_key // empty' "${work}/key.json")"
    if [ -z "${access}" ] || [ ${#secret} -lt 20 ] || [ "${secret}" != "${secret#*\*}" ]; then
        if [ -n "${access}" ] && ! delete_spaces_key "${access}"; then
            echo "WARNING: delete the Spaces key ${access}: ${doctl[*]} spaces keys delete ${access}" >&2
        fi
        fail "doctl did not return the new Spaces key \"$1\" in full (its secret was missing or masked); nothing was stored."
    fi
}

key_field() {
    jq -j ".$1" "${work}/key.json"
}

# The storage sync's key, stored as secrets of github_repository.
setup_sync_key() {
    local name="${bucket}-storage-sync"
    local repository
    repository="$(field .github_repository "")"

    if [ -z "${repository}" ]; then
        echo "No github_repository in stack.json: skipping the storage sync's key."
        return
    fi
    require gh

    if ${plan}; then
        echo "Storage sync key \"${name}\" (readwrite on ${bucket}), stored in ${repository}:"
        run "${doctl[@]}" spaces keys create "${name}" --grants "bucket=${bucket};permission=readwrite"
        run gh secret set DESTINATION_ACCESS_KEY_ID -R "${repository}"
        run gh secret set DESTINATION_SECRET_ACCESS_KEY -R "${repository}"
        return
    fi

    local existing secrets secret in_github=0
    existing="$(spaces_key_access "${name}")"
    secrets="$(gh secret list -R "${repository}" --json name --jq '.[].name')" \
        || fail "gh cannot list the secrets of ${repository}"
    for secret in DESTINATION_ACCESS_KEY_ID DESTINATION_SECRET_ACCESS_KEY; do
        if grep -qx "${secret}" <<<"${secrets}"; then
            in_github=$((in_github + 1))
        fi
    done

    if [ -n "${existing}" ] && [ "${in_github}" -eq 2 ]; then
        echo "Storage sync key \"${name}\" exists and ${repository} has its secrets."
        return
    fi
    if [ -n "${existing}" ]; then
        fail "Spaces key \"${name}\" exists but ${repository} lacks its DESTINATION_* secrets, and a key's secret cannot be read back. Delete the key (${doctl[*]} spaces keys delete ${existing}) and run this again."
    fi
    if [ "${in_github}" -gt 0 ]; then
        fail "${repository} already has DESTINATION_* secrets but there is no Spaces key \"${name}\": they hold some other key. Delete them (gh secret delete <name> -R ${repository}) and run this again."
    fi

    create_spaces_key "${name}" "bucket=${bucket};permission=readwrite"
    if key_field access_key | gh secret set DESTINATION_ACCESS_KEY_ID -R "${repository}" >/dev/null \
        && key_field secret_key | gh secret set DESTINATION_SECRET_ACCESS_KEY -R "${repository}" >/dev/null; then
        echo "Storage sync key \"${name}\" created and stored as ${repository}'s DESTINATION_* secrets."
    else
        local access
        access="$(key_field access_key)"
        gh secret delete DESTINATION_ACCESS_KEY_ID -R "${repository}" >/dev/null 2>&1 || true
        delete_spaces_key "${access}" \
            || fail "could not store the storage sync key in ${repository}, nor delete it again. Delete it (${doctl[*]} spaces keys delete ${access}) and any DESTINATION_* secret in ${repository}, then run this again."
        fail "could not store the storage sync key in ${repository}; the key was deleted again. Check gh's access and run this again."
    fi
    rm -f "${work}/key.json"
}

# cloud_secret_id <secrets json> <name>: the id of the Laravel Cloud secret
# with that name, or nothing. More than one is an error.
cloud_secret_id() {
    jq -r --arg name "$2" '
        map(select(.key == $name))
        | if length > 1 then error("several secrets share the name") else (.[0].id // empty | tostring) end' <<<"$1" \
        || fail "more than one Laravel Cloud secret is named $2, or cloud's output was unexpected. Check: cloud secret:list"
}

# The database apps' key: one per bucket, shared by every cloud-db-backup
# deployment in the organization. Laravel Cloud secrets belong to the
# organization and are attached to environments.
setup_db_key() {
    local environment="$1"
    local name="${bucket}-db-backup"
    require cloud

    if ${plan}; then
        echo "Database key \"${name}\" (readwrite on ${bucket}), stored in Laravel Cloud and attached to ${environment}:"
        run "${doctl[@]}" spaces keys create "${name}" --grants "bucket=${bucket};permission=readwrite"
        run cloud secret:create --name BACKUP_S3_KEY --json
        run cloud secret:create --name BACKUP_S3_SECRET --json
        run cloud environment-secret:attach "${environment}" '<BACKUP_S3_KEY id>' '<BACKUP_S3_SECRET id>'
        return
    fi

    local existing secrets key_id secret_id
    existing="$(spaces_key_access "${name}")"
    secrets="$(cloud secret:list --json)" || fail "cannot list Laravel Cloud secrets; is cloud signed in to the right organization?"
    key_id="$(cloud_secret_id "${secrets}" BACKUP_S3_KEY)"
    secret_id="$(cloud_secret_id "${secrets}" BACKUP_S3_SECRET)"

    if [ -n "${key_id}" ] && [ -n "${secret_id}" ]; then
        [ -n "${existing}" ] || fail "Laravel Cloud already has BACKUP_S3_KEY / BACKUP_S3_SECRET but there is no Spaces key \"${name}\": they hold some other key. Delete them (cloud secret:delete <id>) and run this again."
        echo "Database key \"${name}\" exists and Laravel Cloud has its secrets."
    elif [ -n "${key_id}" ] || [ -n "${secret_id}" ]; then
        fail "Laravel Cloud has only one of BACKUP_S3_KEY / BACKUP_S3_SECRET. Delete it (cloud secret:delete <id>) and run this again."
    else
        [ -z "${existing}" ] || fail "Spaces key \"${name}\" exists but Laravel Cloud lacks its secrets, and a key's secret cannot be read back. Delete the key (${doctl[*]} spaces keys delete ${existing}) and run this again."

        create_spaces_key "${name}" "bucket=${bucket};permission=readwrite"
        local note="Spaces key ${name}, limited to bucket ${bucket}; for cloud-db-backup. Made by setup-bucket."
        if key_id="$(key_field access_key | cloud secret:create --name BACKUP_S3_KEY --notes "${note}" --json --no-interaction | jq -r '.id // empty | tostring')" \
            && [ -n "${key_id}" ] \
            && secret_id="$(key_field secret_key | cloud secret:create --name BACKUP_S3_SECRET --notes "${note}" --json --no-interaction | jq -r '.id // empty | tostring')" \
            && [ -n "${secret_id}" ]; then
            echo "Database key \"${name}\" created and stored as the Laravel Cloud secrets BACKUP_S3_KEY / BACKUP_S3_SECRET."
        else
            # Undo by name: a create can succeed without its id being read back.
            local access left="" now secret_name stray
            access="$(key_field access_key)"
            delete_spaces_key "${access}" || left="${left}
  ${doctl[*]} spaces keys delete ${access}"
            now="$(cloud secret:list --json 2>/dev/null || echo '[]')"
            for secret_name in BACKUP_S3_KEY BACKUP_S3_SECRET; do
                for stray in $(jq -r --arg name "${secret_name}" '.[]? | select(.key == $name) | .id | tostring' <<<"${now}" 2>/dev/null || true); do
                    cloud secret:delete "${stray}" --force --no-interaction >/dev/null 2>&1 || left="${left}
  cloud secret:delete ${stray} --force     (${secret_name})"
                done
            done
            [ -z "${left}" ] || fail "could not store the database key in Laravel Cloud, nor fully undo it. Run these, then run this again:${left}"
            fail "could not store the database key in Laravel Cloud; the key and any secret made for it were deleted again. Run this again."
        fi
        rm -f "${work}/key.json"
    fi

    local attached id missing=()
    attached="$(cloud environment-secret:list "${environment}" --json)" || fail "cannot read the secrets of environment ${environment}"
    for id in "${key_id}" "${secret_id}"; do
        if ! jq -e --arg id "${id}" 'any(.[]?; (.id | tostring) == $id)' <<<"${attached}" >/dev/null; then
            missing+=("${id}")
        fi
    done
    if [ ${#missing[@]} -gt 0 ]; then
        cloud environment-secret:attach "${environment}" "${missing[@]}" --no-interaction >/dev/null \
            || fail "could not attach the secrets to environment ${environment}"
        echo "Secrets attached to environment ${environment}."
    else
        echo "Secrets already attached to environment ${environment}."
    fi

    cat <<EOF

Next, on environment ${environment}, set these variables, then deploy it
(variables and secrets apply on deploy):
  BACKUP_S3_BUCKET=${bucket}
  BACKUP_S3_REGION=${region}
  BACKUP_S3_ENDPOINT=${endpoint}
  BACKUP_S3_STORAGE_CLASS=       (empty: Spaces has no storage classes)
EOF
}

setup_digitalocean() {
    require doctl

    local context
    context="$(field .doctl_context "")"
    [ -z "${context}" ] || doctl+=(--context "${context}")
    [ -n "${endpoint}" ] || endpoint="https://${region}.digitaloceanspaces.com"

    echo "DigitalOcean (doctl context: ${context:-current}): bucket ${bucket} at ${endpoint}."
    if ! ${plan}; then
        "${doctl[@]}" spaces keys list -o json >/dev/null 2>&1 \
            || fail "doctl cannot list Spaces keys. Sign in with: doctl auth init${context:+ --context ${context}}, using a token from the team that should own the backups."
    fi

    if [ -n "${db_key_environment}" ]; then
        setup_db_key "${db_key_environment}"
        return
    fi

    # Check gh before making any key, so a missing sign-in fails early.
    local repository
    repository="$(field .github_repository "")"
    if [ -n "${repository}" ] && ! ${plan}; then
        require gh
        gh secret list -R "${repository}" >/dev/null \
            || fail "gh cannot list the secrets of ${repository}; sign in (gh auth login) as someone who can set them."
    fi

    # DigitalOcean's docs: sign as us-east-1 when creating a Space (any other
    # value is sent as a location constraint); the endpoint picks the real
    # region. Apps using an existing Space may sign with its own region.
    s3api=(aws --endpoint-url "${endpoint}" --region us-east-1 s3api)

    if ${plan}; then
        run "${doctl[@]}" spaces keys create setup-bucket-temporary --grants "bucket=;permission=fullaccess"
    else
        # Only this process uses the temporary key; no profile or session
        # token may override it.
        unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN
        temp_name="setup-bucket-temporary-$(date +%Y%m%d%H%M%S)-$$"
        create_spaces_key "${temp_name}" "bucket=;permission=fullaccess"
        temp_key="$(key_field access_key)"
        export AWS_ACCESS_KEY_ID="${temp_key}"
        AWS_SECRET_ACCESS_KEY="$(key_field secret_key)"
        export AWS_SECRET_ACCESS_KEY
        rm -f "${work}/key.json"

        # A new key can take a few seconds to be accepted.
        local tries=0
        until "${s3api[@]}" list-buckets >/dev/null 2>&1; do
            tries=$((tries + 1))
            [ "${tries}" -lt 30 ] || fail "the temporary Spaces key was not accepted at ${endpoint} within a minute"
            sleep 2
        done
    fi

    configure_bucket
    # The temporary key's job is done; nothing after this needs it.
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    setup_sync_key

    cat <<EOF

Next:
  1. In buckets.yml's destination, set
       endpoint: ${endpoint}
       provider: DigitalOcean
  2. After deploying cloud-db-backup to Laravel Cloud, give it the database key:
       $0 ${config} --db-key <environment id>
  Spaces keys that can write can also delete, so treat both keys as able to
  remove backups.
EOF
}

if [ -n "${db_key_environment}" ] && [ "${provider}" != "digitalocean" ]; then
    fail "--db-key is only for provider \"digitalocean\""
fi

case "${provider}" in
    aws) setup_aws ;;
    s3-compatible) setup_s3_compatible ;;
    digitalocean) setup_digitalocean ;;
    *) fail "\"provider\" must be \"aws\", \"digitalocean\" or \"s3-compatible\" (got \"${provider}\")" ;;
esac
